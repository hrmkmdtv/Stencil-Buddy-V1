{
    "name": "stencil-art",
    "version": "1.0.0",
    "description": "A progressive web app for creating stencil art effects",
    "main": "index.js",
    "scripts": {
        "start": "serve dist",
        "dev": "serve . -p 3000",
        "build": "node build.js",
        "test": "jest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "analyze": "source-map-explorer dist/**/*.js",
        "lighthouse": "lighthouse http://localhost:3000 --quiet --chrome-flags='--headless' --output-path=./lighthouse-report.html",
        "deploy": "npm run build && firebase deploy",
        "pwa-check": "lighthouse http://localhost:3000 --quiet --chrome-flags='--headless' --output=json --output-path=./pwa-score.json --preset=pwa"
    },
    "keywords": [
        "pwa",
        "stencil",
        "art",
        "image",
        "effects",
        "offline"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "workbox-window": "^7.0.0",
        "workbox-core": "^7.0.0",
        "workbox-precaching": "^7.0.0",
        "workbox-routing": "^7.0.0",
        "workbox-strategies": "^7.0.0",
        "workbox-background-sync": "^7.0.0",
        "workbox-broadcast-update": "^7.0.0",
        "workbox-cacheable-response": "^7.0.0",
        "workbox-expiration": "^7.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.22.0",
        "@babel/preset-env": "^7.22.0",
        "babel-jest": "^29.0.0",
        "csso": "^5.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^8.8.0",
        "firebase-tools": "^12.0.0",
        "imagemin": "^8.0.0",
        "imagemin-mozjpeg": "^10.0.0",
        "imagemin-pngquant": "^9.0.0",
        "imagemin-svgo": "^10.0.0",
        "jest": "^29.0.0",
        "lighthouse": "^10.0.0",
        "prettier": "^2.8.0",
        "serve": "^14.0.0",
        "source-map-explorer": "^2.5.0",
        "terser": "^5.18.0",
        "workbox-build": "^7.0.0"
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "engines": {
        "node": ">=16.0.0"
    },
    "jest": {
        "transform": {
            "^.+\\.js$": "babel-jest"
        },
        "testEnvironment": "jsdom",
        "setupFiles": [
            "<rootDir>/test/setup.js"
        ]
    },
    "eslintConfig": {
        "extends": [
            "eslint:recommended",
            "prettier"
        ],
        "env": {
            "browser": true,
            "es2021": true,
            "node": true,
            "serviceworker": true
        }
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "es5",
        "printWidth": 100,
        "tabWidth": 2
    },
    "babel": {
        "presets": [
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    },
    "lighthouse": {
        "extends": "lighthouse:default",
        "settings": {
            "onlyCategories": [
                "performance",
                "accessibility",
                "best-practices",
                "seo",
                "pwa"
            ]
        }
    }
}
